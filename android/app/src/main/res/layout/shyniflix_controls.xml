<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_overlay_controls" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical">

    <LinearLayout android:id="@+id/player_header_controls" android:layout_width="match_parent"
        android:layout_height="66dp" android:gravity="center_vertical" android:background="@drawable/player_header_gradient"
        android:paddingStart="16dp" android:paddingEnd="80dp">
        <ImageButton android:id="@+id/player_back" style="@style/PlayerIconControl"
            android:src="@drawable/ic_player_back" android:contentDescription="뒤로" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:id="@+id/player_title" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="18sp"
                android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/player_mode" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="#D6FFFFFF" android:textSize="12sp"
                android:maxLines="1" android:importantForAccessibility="yes" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/player_transport_controls" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center_vertical">
            <ImageButton android:id="@id/exo_rew" style="@style/PlayerIconControl"
                android:src="@drawable/ic_player_rewind" android:contentDescription="10초 뒤로" />
            <ImageButton android:id="@id/exo_play_pause" style="@style/PlayerIconControl"
                android:layout_width="64dp" android:layout_height="64dp" android:layout_marginHorizontal="20dp"
                android:padding="17dp" android:background="@drawable/player_primary_control"
                android:tint="#14191D" android:contentDescription="재생 또는 일시정지" />
            <ImageButton android:id="@id/exo_ffwd" style="@style/PlayerIconControl"
                android:src="@drawable/ic_player_fast_forward" android:contentDescription="10초 앞으로" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout android:id="@+id/player_bottom_controls" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp"
        android:paddingBottom="8dp" android:background="@drawable/tv_player_scrim">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
            <TextView android:id="@id/exo_position" style="@style/PlayerTimeLabel" />
            <androidx.media3.ui.DefaultTimeBar android:id="@id/exo_progress" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="match_parent" android:focusable="true"
                app:bar_height="3dp" app:touch_target_height="48dp" app:played_color="#FFFFFF"
                app:scrubber_color="#FFFFFF" app:buffered_color="#99FFFFFF" app:unplayed_color="#50FFFFFF" />
            <TextView android:id="@id/exo_duration" style="@style/PlayerTimeLabel" android:gravity="end" />
        </LinearLayout>
        <HorizontalScrollView android:id="@+id/player_control_scroller" android:layout_width="match_parent"
            android:layout_height="48dp" android:fillViewport="true" android:focusable="false"
            android:descendantFocusability="afterDescendants" android:scrollbars="none">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical">
                <ImageButton android:id="@+id/player_previous" style="@style/PlayerIconControl"
                    android:src="@drawable/ic_player_previous" android:contentDescription="이전 영상"
                    android:enabled="false" android:alpha="0.35" />
                <ImageButton android:id="@+id/player_next" style="@style/PlayerIconControl"
                    android:src="@drawable/ic_player_next" android:contentDescription="다음 영상"
                    android:enabled="false" android:alpha="0.35" />
                <Button android:id="@+id/player_continuous" style="@style/PlayerTextControl"
                    android:layout_width="72dp" android:text="연속재생&#10;꺼짐" android:contentDescription="연속 재생 꺼짐" />
                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <Button android:id="@+id/player_speed" style="@style/PlayerTextControl"
                    android:layout_width="56dp" android:text="1×" android:textSize="14sp" android:contentDescription="배속 설정" />
                <Button android:id="@+id/player_conversion" style="@style/PlayerTextControl"
                    android:layout_width="68dp" android:text="변환&#10;원본" android:contentDescription="변환 (데이터 절약)" />
                <ImageButton android:id="@+id/player_subtitles" style="@style/PlayerIconControl"
                    android:src="@drawable/ic_player_subtitles" android:contentDescription="자막 선택" android:enabled="false" />
                <ImageButton android:id="@+id/player_resize" style="@style/PlayerIconControl"
                    android:src="@drawable/ic_player_fit" android:contentDescription="화면 맞춤" />
                <ImageButton android:id="@+id/player_settings" style="@style/PlayerIconControl"
                    android:src="@drawable/ic_player_settings" android:contentDescription="재생 설정" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</LinearLayout>
