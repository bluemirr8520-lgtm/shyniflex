<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
  <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:background="#33000000" android:paddingStart="32dp" android:paddingEnd="32dp">
    <Button android:id="@+id/player_back" android:layout_width="68dp" android:layout_height="56dp" android:text="닫기" android:textColor="#FFFFFF" android:background="@drawable/tv_player_button" android:backgroundTint="@null" android:stateListAnimator="@null" android:elevation="0dp" />
    <TextView android:id="@+id/player_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:padding="12dp" android:textColor="#FFFFFF" android:textSize="18sp" android:maxLines="1" android:ellipsize="end" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="136dp" android:layout_gravity="bottom" android:orientation="vertical" android:background="@drawable/tv_player_scrim" android:paddingHorizontal="24dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical">
      <TextView android:id="@id/exo_position" android:layout_width="66dp" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="16sp" />
      <androidx.media3.ui.DefaultTimeBar android:id="@id/exo_progress" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:focusable="true" app:played_color="#7BE6C6" app:scrubber_color="#7BE6C6" app:buffered_color="#657888" app:unplayed_color="#30404D" />
      <TextView android:id="@id/exo_duration" android:layout_width="66dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="#FFFFFF" android:textSize="16sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical">
      <ImageButton android:id="@+id/player_previous" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_player_previous" android:tint="#FFFFFF" android:padding="10dp" android:contentDescription="이전 영상" android:enabled="false" android:alpha="0.35" android:background="@drawable/tv_player_button" android:backgroundTint="@null" android:stateListAnimator="@null" android:elevation="0dp" />
      <ImageButton android:id="@id/exo_rew" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_player_rewind" android:tint="#FFFFFF" android:contentDescription="10초 뒤로" android:background="@drawable/tv_player_button" android:backgroundTint="@null" android:stateListAnimator="@null" android:elevation="0dp" android:padding="10dp" />
      <ImageButton android:id="@id/exo_play_pause" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/tv_player_button" android:backgroundTint="@null" android:stateListAnimator="@null" android:elevation="0dp" android:contentDescription="재생 또는 일시정지" android:padding="10dp" />
      <ImageButton android:id="@id/exo_ffwd" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_player_fast_forward" android:tint="#FFFFFF" android:contentDescription="10초 앞으로" android:background="@drawable/tv_player_button" android:backgroundTint="@null" android:stateListAnimator="@null" android:elevation="0dp" android:padding="10dp" />
      <ImageButton android:id="@+id/player_next" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_player_next" android:tint="#FFFFFF" android:padding="10dp" android:contentDescription="다음 영상" android:enabled="false" android:alpha="0.35" android:background="@drawable/tv_player_button" android:backgroundTint="@null" android:stateListAnimator="@null" android:elevation="0dp" />
      <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
      <Button android:id="@+id/player_speed" android:layout_width="56dp" android:layout_height="48dp" android:text="1×" android:textSize="13sp" android:textColor="#FFFFFF" android:minWidth="0dp" android:paddingHorizontal="4dp" android:contentDescription="배속 설정" android:background="@drawable/tv_player_button" android:backgroundTint="@null" android:stateListAnimator="@null" android:elevation="0dp" />
      <Button android:id="@+id/player_conversion" android:layout_width="72dp" android:layout_height="48dp" android:text="변환" android:textSize="13sp" android:textColor="#FFFFFF" android:minWidth="0dp" android:paddingHorizontal="4dp" android:maxLines="1" android:ellipsize="end" android:contentDescription="변환 (데이터 절약)" android:background="@drawable/tv_player_button" android:backgroundTint="@null" android:stateListAnimator="@null" android:elevation="0dp" />
      <ImageButton android:id="@+id/player_subtitles" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_player_subtitles" android:tint="#FFFFFF" android:padding="10dp" android:contentDescription="자막 선택" android:enabled="false" android:background="@drawable/tv_player_button" android:backgroundTint="@null" android:stateListAnimator="@null" android:elevation="0dp" />
      <ImageButton android:id="@+id/player_resize" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_player_fit" android:tint="#FFFFFF" android:padding="10dp" android:contentDescription="화면 맞춤" android:background="@drawable/tv_player_button" android:backgroundTint="@null" android:stateListAnimator="@null" android:elevation="0dp" />
      <ImageButton android:id="@+id/player_settings" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_player_settings" android:tint="#FFFFFF" android:padding="10dp" android:contentDescription="재생 설정" android:background="@drawable/tv_player_button" android:backgroundTint="@null" android:stateListAnimator="@null" android:elevation="0dp" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
