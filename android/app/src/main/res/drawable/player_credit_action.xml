<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#55FFFFFF">
    <item android:id="@android:id/mask">
        <shape><corners android:radius="999dp" /><solid android:color="#FFFFFFFF" /></shape>
    </item>
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape><corners android:radius="999dp" /><solid android:color="#66333333" /></shape>
            </item>
            <item android:state_pressed="true">
                <shape><corners android:radius="999dp" /><solid android:color="#EF333333" /><stroke android:width="2dp" android:color="#FFFFFFFF" /></shape>
            </item>
            <item android:state_focused="true">
                <shape><corners android:radius="999dp" /><solid android:color="#EE3B3B3B" /><stroke android:width="2dp" android:color="#FFFFFFFF" /></shape>
            </item>
            <item>
                <shape><corners android:radius="999dp" /><solid android:color="#D91B1B1B" /><stroke android:width="1dp" android:color="#77FFFFFF" /></shape>
            </item>
        </selector>
    </item>
</ripple>
