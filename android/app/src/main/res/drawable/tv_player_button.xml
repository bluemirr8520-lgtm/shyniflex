<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#22FFFFFF">
    <item android:id="@android:id/mask"><shape><solid android:color="#FFFFFFFF" /></shape></item>
    <item>
        <selector>
            <item android:state_enabled="false"><shape><solid android:color="@android:color/transparent" /></shape></item>
            <item android:state_pressed="true"><shape><solid android:color="#226255" /></shape></item>
            <item android:state_focused="true"><shape><solid android:color="#226255" /></shape></item>
            <item android:state_selected="true"><shape><solid android:color="#226255" /></shape></item>
            <item><shape><solid android:color="@android:color/transparent" /></shape></item>
        </selector>
    </item>
</ripple>
