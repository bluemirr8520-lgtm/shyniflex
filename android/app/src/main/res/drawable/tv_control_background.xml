<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="#142536" /><corners android:radius="10dp" /></shape>
    </item>
    <item android:state_focused="true">
        <shape><solid android:color="#30584F" /><stroke android:width="3dp" android:color="#83E3C5" /><corners android:radius="10dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#142536" /><corners android:radius="10dp" /></shape>
    </item>
</selector>
